# ─────────────────────────────────────────────────────────────────────────────
# AgentForge — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./agentforge.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://agentforge:PASSWORD@localhost:5432/agentforge

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
API_KEY_PEPPER=CHANGE_ME_generate_with_secrets_token_hex_32
AIAM_SIGNING_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# ── OAuth2 / SSO (optional) ────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_OKTA_DOMAIN=              # e.g. acme.okta.com
OAUTH_OKTA_CLIENT_ID=
OAUTH_OKTA_CLIENT_SECRET=

OAUTH_AZURE_TENANT_ID=
OAUTH_AZURE_CLIENT_ID=
OAUTH_AZURE_CLIENT_SECRET=

# ── HITL Notifications ─────────────────────────────────────────────────────────
# Slack incoming webhook (simplest):
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_APPROVAL_CHANNEL=#agent-approvals

# Email (SMTP):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=agentforge@yourdomain.com

# PagerDuty (critical escalations):
PAGERDUTY_ROUTING_KEY=

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# OpenTelemetry (optional):
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agentforge

# ── Multi-tenancy ──────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=default

# ── SaaS / Marketplace ────────────────────────────────────────────────────────
SAAS_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AWS_MARKETPLACE_PRODUCT_CODE=

# ── Docker Compose only ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
